# PostgreSQL Database Connection (Neon Serverless compatible)
DATABASE_URL="postgresql://user:password@ep-neon-database-pooler.neon.tech/ird_lottery?sslmode=require&pgbouncer=true&connection_limit=20&pool_timeout=30"

# Official IRD Public API Configuration
IRD_API_URL="https://prize.ird.gov.np/api/v1/public/winners"
IRD_API_TIMEOUT="10000"

# Hybrid OCR Pipeline Configuration
OCR_PROVIDER="hybrid"
LOCAL_OCR_PROVIDER="rapidocr"
FALLBACK_PROVIDER="openrouter"
OCR_CONFIDENCE_THRESHOLD="0.90"

# OpenRouter Vision OCR Configuration
OPENROUTER_API_KEY="sk-or-v1-your-openrouter-key-here"
OPENROUTER_MODEL="google/gemini-2.5-flash"
